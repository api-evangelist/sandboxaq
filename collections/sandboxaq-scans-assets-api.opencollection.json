{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flint AI Platform scans assets API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "scans assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all scans associated with an asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.flintai.dev/api/v1/scans/asset/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Asset Id"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get all scans (active or not) linked to the given asset"
        }
      ]
    }
  ],
  "bundled": true
}